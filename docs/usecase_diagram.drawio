<mxfile host="app.diagrams.net">
  <diagram name="Use Case Diagram" id="pm25-usecase">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Actors: ตัวก้างมาตรฐาน (umlActor) ไม่มีสี -->
        <mxCell id="actor_guest" value="ผู้ใช้ทั่วไป" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="60" height="100" as="geometry" />
        </mxCell>
        <mxCell id="actor_reguser" value="ผู้ใช้ที่ลงทะเบียน" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="880" width="60" height="100" as="geometry" />
        </mxCell>

        <!-- System boundary -->
        <mxCell id="boundary" value="ระบบพยากรณ์ PM2.5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#000000;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="480" height="1080" as="geometry" />
        </mxCell>

        <!-- Column 1: Guest-accessible use cases -->
        <mxCell id="uc_forecast" value="ดูพยากรณ์ 24 ชม." style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_current" value="ดูค่า PM2.5 ปัจจุบัน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_map" value="ดูแผนที่ภาพรวมทุกจังหวัด" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="180" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_selectprovince" value="เลือกจังหวัดที่ต้องการดู" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="240" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_besttime" value="ดูช่วงเวลาที่อากาศดีที่สุด" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_daily" value="ดูสรุปคุณภาพอากาศรายวัน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="360" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_risk" value="ดูคะแนนความเสี่ยงส่วนบุคคล" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="420" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_activity" value="เลือกความหนักกิจกรรม" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="480" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_notif" value="ดูการแจ้งเตือน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="540" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_pwa" value="ติดตั้งเป็นเว็บแอปพลิเคชัน (PWA)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="600" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_login" value="เข้าสู่ระบบ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="660" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_register" value="ลงทะเบียน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="720" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Registered-user-only use cases (continue column 1) -->
        <mxCell id="uc_profile" value="จัดการโปรไฟล์" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="800" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_riskgroup" value="ตั้งค่ากลุ่มความเสี่ยง" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="860" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_homeprovince" value="ตั้งจังหวัดหลัก" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="920" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_changepassword" value="เปลี่ยนรหัสผ่าน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="980" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_logout" value="ออกจากระบบ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="1040" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Column 2: internal / system use cases -->
        <mxCell id="uc_route" value="เลือกโมเดล (Dynamic Routing)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_breaker" value="สลับใช้ Persistence (Circuit Breaker)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_log" value="บันทึกผลพยากรณ์" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_backfill" value="เติมค่าจริงย้อนหลัง" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_nlg" value="สร้างข้อความอธิบาย (NLG)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Generalization: RegUser inherits from Guest -->
        <mxCell id="e_gen" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_reguser" target="actor_guest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Guest associations -->
        <mxCell id="e1" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_forecast"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_current"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_map"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_selectprovince"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_besttime"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_daily"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_risk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_activity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_notif"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_pwa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_login"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_guest" target="uc_register"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- RegUser associations -->
        <mxCell id="e13" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_reguser" target="uc_profile"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_reguser" target="uc_riskgroup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_reguser" target="uc_homeprovince"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_reguser" target="uc_changepassword"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="actor_reguser" target="uc_logout"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- include / extend relationships -->
        <mxCell id="e_inc1" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_forecast" target="uc_route"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_inc2" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_forecast" target="uc_log"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_inc3" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_forecast" target="uc_backfill"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ext1" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_route" target="uc_breaker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_inc4" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_daily" target="uc_nlg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_inc5" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_risk" target="uc_activity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ext2" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="uc_risk" target="uc_riskgroup"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
